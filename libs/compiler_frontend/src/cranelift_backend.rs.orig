use crate::mir::{MirFunction, MirInst, MirModule, MirOp};
use alloc::string::String;
use alloc::vec::Vec;
use cranelift_codegen::{
    ir::{types, AbiParam, InstBuilder, Signature, UserFuncName},
    isa::{CallConv, TargetIsa},
    settings::{self, Flags},
};
use cranelift_frontend::{FunctionBuilder, FunctionBuilderContext, Variable};
use target_lexicon::Architecture;
use cranelift_codegen::entity::EntityRef;

pub enum CompileError {
    UnsupportedArchitecture(String),
    CompilationFailed,
}

pub struct CraneliftBackend {
    isa: alloc::boxed::Box<dyn TargetIsa>,
}

impl CraneliftBackend {
    pub fn new(target_arch: &str) -> Result<Self, CompileError> {
        let arch = match target_arch {
            "x86_64" => Architecture::X86_64,
            "aarch64" => Architecture::Aarch64(target_lexicon::Aarch64Architecture::Aarch64),
            "riscv64" => Architecture::Riscv64(target_lexicon::Riscv64Architecture::Riscv64gc),
            "wasm32" => Architecture::Wasm32,
            _ => {
                return Err(CompileError::UnsupportedArchitecture(
                    target_arch.into(),
                ))
            }
        };

        let mut flag_builder = settings::builder();
        flag_builder.set("opt_level", "speed_and_size").unwrap();
        let flags = Flags::new(flag_builder);

        // Build target isa
        let triple = target_lexicon::Triple {
            architecture: arch,
            vendor: target_lexicon::Vendor::Unknown,
            operating_system: target_lexicon::OperatingSystem::Unknown,
            environment: target_lexicon::Environment::Unknown,
            binary_format: target_lexicon::BinaryFormat::Unknown,
        };

        let isa = cranelift_codegen::isa::lookup(triple)
            .map_err(|_| CompileError::UnsupportedArchitecture(target_arch.into()))?
            .finish(flags)
            .map_err(|_| CompileError::CompilationFailed)?;

        Ok(Self { isa })
    }

    pub fn compile_module(&self, module: &MirModule) -> Result<Vec<cranelift_codegen::ir::Function>, CompileError> {
        let mut compiled_funcs = Vec::new();

        for (func_idx, func) in module.functions.iter().enumerate() {
            let mut sig = Signature::new(CallConv::SystemV);

            // All params are i64 for simplicity in this frontend
            for _ in 0..func.param_count {
                sig.params.push(AbiParam::new(types::I64));
            }
            // All returns are i64
            sig.returns.push(AbiParam::new(types::I64));

            let mut fn_builder_ctx = FunctionBuilderContext::new();
            let mut cranelift_func = cranelift_codegen::ir::Function::with_name_signature(
                UserFuncName::user(0, func_idx as u32),
                sig,
            );

            {
                let mut builder = FunctionBuilder::new(&mut cranelift_func, &mut fn_builder_ctx);
                let entry_block = builder.create_block();

                builder.append_block_params_for_function_params(entry_block);
                builder.switch_to_block(entry_block);
                builder.seal_block(entry_block);

                // Define local variables
                for i in 0..func.locals_count {
                    let var = Variable::new(i);
                    builder.declare_var(var, types::I64);
                }

                // Map function params to locals
                for i in 0..func.param_count {
                    let val = builder.block_params(entry_block)[i];
                    let var = Variable::new(i);
                    builder.def_var(var, val);
                }

                for inst in &func.insts {
                    match inst {
                        MirInst::Assign { dest, op } => {
                            let val = match op {
                                MirOp::Const(v) => builder.ins().iconst(types::I64, *v),
                                MirOp::Load(src) => {
                                    let var = Variable::new(*src);
                                    builder.use_var(var)
                                }
                                MirOp::Add(lhs, rhs) => {
                                    let lhs_val = builder.use_var(Variable::new(*lhs));
                                    let rhs_val = builder.use_var(Variable::new(*rhs));
                                    builder.ins().iadd(lhs_val, rhs_val)
                                }
                                MirOp::Sub(lhs, rhs) => {
                                    let lhs_val = builder.use_var(Variable::new(*lhs));
                                    let rhs_val = builder.use_var(Variable::new(*rhs));
                                    builder.ins().isub(lhs_val, rhs_val)
                                }
                                MirOp::Mul(lhs, rhs) => {
                                    let lhs_val = builder.use_var(Variable::new(*lhs));
                                    let rhs_val = builder.use_var(Variable::new(*rhs));
                                    builder.ins().imul(lhs_val, rhs_val)
                                }
                                MirOp::Call(_, _) => {
                                    // Complex calls skipped for this stub implementation
                                    builder.ins().iconst(types::I64, 0)
                                }
                            };
                            builder.def_var(Variable::new(*dest), val);
                        }
                        MirInst::Return { src } => {
                            let val = builder.use_var(Variable::new(*src));
                            builder.ins().return_(&[val]);
                        }
                        MirInst::Nop => {}
                    }
                }

                builder.finalize();
            }

            compiled_funcs.push(cranelift_func);
        }

        Ok(compiled_funcs)
    }
}
